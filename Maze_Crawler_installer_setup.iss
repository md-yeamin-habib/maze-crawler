; Script generated by Inno Setup Script Wizard
; Project: Maze Crawler Desktop App

#define AppName "Maze Crawler"
#define AppVersion "1.0.0"
#define AppPublisher "Md. Yeamin Habib"
#define AppURL "https://github.com/md-yeamin-habib/maze-crawler"
#define AppExeName "run_app.exe"

[Setup]
; Unique App ID for Windows registry
AppId={{C9A32F5B-41E2-4E9A-98C3-1FA2B71EF8C1}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
AppUpdatesURL={#AppURL}
; Installs inside user's Local AppData by default (No Admin rights required)
DefaultDirName={autopf}\{#AppName}
DisableProgramGroupPage=yes
; Output installer package settings
OutputDir=installer_output
OutputBaseFilename=MazeCrawler-Setup-v1.0.0
SetupIconFile=static\icon.ico
; Fixes the generic icon in Windows Settings > Installed Apps list
UninstallDisplayIcon={app}\{#AppExeName}
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; IMPORTANT: Make sure you have already run PyInstaller once so the 'dist\run_app' folder exists!
Source: "dist\run_app\{#AppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "dist\run_app\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; Pull the icon directly from the embedded executable binary for desktop & start menu shortcuts
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExeName}"; IconFilename: "{app}\{#AppExeName}"; IconIndex: 0
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExeName}"; IconFilename: "{app}\{#AppExeName}"; IconIndex: 0; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(AppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent